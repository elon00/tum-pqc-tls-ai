{
  "mcpServers": {
    "tum-pqc-tls-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "TUM Munich",
        "PROJECT_TICKER": "TUMTLS"
      },
      "tools": [
        {
          "name": "verify_tumtls_invariants",
          "description": "Verifies deterministic invariants for TUM PQC-TLS AI on TUM Munich."
        },
        {
          "name": "execute_tumtls_action",
          "description": "Executes authenticated Security state transition."
        }
      ]
    }
  }
}